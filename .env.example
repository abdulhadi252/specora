# ═══════════════════════════════════════
# Specora — Environment Configuration
# ═══════════════════════════════════════
# Copy this file as .env and fill in your credentials.
# NEVER commit the .env file to version control!
#
# Steps to set up:
#   1. cp .env.example .env
#   2. Edit .env with your actual values
#   3. Run the project

# ── Application ──
# Set to "development" for error display, "production" for silent logging
APP_ENV=production

# ── Logging ──
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING

# ── Database ──
# Default XAMPP credentials — change for production
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=specora

# ── SMTP / Email Configuration ──
SMTP_HOST=smtp.mailersend.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=YOUR_SMTP_USERNAME_HERE
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_FROM_EMAIL=noreply@specora.pk
SMTP_FROM_NAME=Specora

# ── API Security Key (REQUIRED — no default fallback) ──
# ╔══════════════════════════════════════════════════════════════════╗
# ║  SECURITY WARNING: This key MUST be set before the app runs.   ║
# ║  The code will refuse to start if API_SECRET_KEY is missing.   ║
# ║  NEVER leave this as a default or placeholder value.           ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Pass this as ?api_key=... to all API endpoints (amazon_to_db.php,
# ebay_to_db.php, aliexpress_to_db.php, walmart_to_db.php, etc.)
#
# Generate a strong key (run this in your terminal):
#   php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
#
# Example output: 7a4f8c2e1b3d5f9a0c8e7b6d4f2a1c3e8b7d5f9a0c4e2b1f3d6a8c
#
API_SECRET_KEY=
